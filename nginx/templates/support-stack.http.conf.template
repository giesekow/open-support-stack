server {
    listen 80;
    server_name __REMOTE_HOST__;
    resolver 127.0.0.11 valid=30s;

    location = / {
        return 302 /guacamole/;
    }

    location /guacamole/ {
        set $upstream_remote guacamole:8080;
        proxy_pass http://$upstream_remote$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 80;
    server_name __HEADSCALE_ROUTE_HOST__;
    resolver 127.0.0.11 valid=30s;

    # Trust only the TLS-terminating upstream proxy when accepting client IPs.
    set_real_ip_from __NGINX_TRUSTED_PROXY_CIDR__;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    location / {
        set $upstream_mesh headscale:8080;
        proxy_pass http://$upstream_mesh;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
    }
}

server {
    listen 80;
    server_name __MESH_WEB_HOST__;
    resolver 127.0.0.11 valid=30s;
    proxy_buffer_size 32k;
    proxy_buffers 8 32k;
    proxy_busy_buffers_size 64k;

    location /oauth2/ {
        set $upstream_oauth2 oauth2-proxy-meshweb:4180;
        proxy_pass http://$upstream_oauth2;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /oauth2/auth {
        set $upstream_oauth2 oauth2-proxy-meshweb:4180;
        proxy_pass http://$upstream_oauth2;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Content-Length "";
        proxy_pass_request_body off;
    }

    # Same-origin API path for Headscale UI to avoid cross-host TLS/CORS issues.
    location = /api/v1/apikeys {
        return 302 /api/v1/apikey;
    }

    location = /api/v1/users {
        return 302 /api/v1/user;
    }

    location = /api/v1/nodes {
        return 302 /api/v1/node;
    }

    location /api/ {
        set $upstream_mesh headscale:8080;
        proxy_pass http://$upstream_mesh;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        auth_request /oauth2/auth;
        error_page 401 =302 /oauth2/start?rd=https://$host$request_uri;
        auth_request_set $auth_user $upstream_http_x_auth_request_user;
        auth_request_set $auth_email $upstream_http_x_auth_request_email;
        proxy_set_header X-Auth-Request-User $auth_user;
        proxy_set_header X-Auth-Request-Email $auth_email;

        set $upstream_mesh_ui headscale-ui:8080;
        proxy_pass http://$upstream_mesh_ui;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# TLS is terminated upstream in this mode. The upstream load balancer must use
# HTTP/2 when forwarding native gRPC requests to this virtual host.
server {
    listen 80;
    http2 on;
    server_name __NETBIRD_HOST__;
    resolver 127.0.0.11 valid=30s;

    client_header_timeout 1d;
    client_body_timeout 1d;

    location ~ ^/(signalexchange\.SignalExchange|management\.(ManagementService|ProxyService))/ {
        set $upstream_netbird_grpc netbird-server:80;
        grpc_pass grpc://$upstream_netbird_grpc;
        grpc_set_header Host $host;
        grpc_set_header X-Real-IP $remote_addr;
        grpc_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        grpc_set_header X-Forwarded-Proto https;
        grpc_read_timeout 1d;
        grpc_send_timeout 1d;
        grpc_socket_keepalive on;
    }

    location ~ ^/(relay|ws-proxy/) {
        set $upstream_netbird netbird-server:80;
        proxy_pass http://$upstream_netbird;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 1d;
        proxy_send_timeout 1d;
    }

    location ~ ^/(api|oauth2)/ {
        set $upstream_netbird netbird-server:80;
        proxy_pass http://$upstream_netbird;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        set $upstream_netbird_dashboard netbird-dashboard:80;
        proxy_pass http://$upstream_netbird_dashboard;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

server {
    listen 80 default_server;
    server_name __SUPPORT_HOST__;
    resolver 127.0.0.11 valid=30s;

    root /usr/share/nginx/html;
    index index.html;

    location /oauth2/ {
        set $upstream_oauth2_portal oauth2-proxy-portal:4180;
        proxy_pass http://$upstream_oauth2_portal;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /oauth2/auth {
        set $upstream_oauth2_portal oauth2-proxy-portal:4180;
        proxy_pass http://$upstream_oauth2_portal;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Content-Length "";
        proxy_pass_request_body off;
    }

    location / {
        auth_request /oauth2/auth;
        error_page 401 =302 /oauth2/start?rd=https://$host$request_uri;
        auth_request_set $auth_user $upstream_http_x_auth_request_user;
        auth_request_set $auth_email $upstream_http_x_auth_request_email;
        add_header X-Auth-Request-User $auth_user always;
        add_header X-Auth-Request-Email $auth_email always;
        try_files $uri $uri/ /index.html;
    }

    location /healthz {
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }
}
