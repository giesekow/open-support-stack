# NetBird combines management, signal, relay, and STUN. STUN bypasses nginx on
# UDP 3478; HTTP, WebSocket, and native gRPC share this TLS virtual host.
server {
    listen 443 ssl;
    http2 on;
    server_name __NETBIRD_HOST__;
    resolver 127.0.0.11 valid=30s;

    ssl_certificate __SSL_CERT_PATH__;
    ssl_certificate_key __SSL_KEY_PATH__;

    client_header_timeout 1d;
    client_body_timeout 1d;

    location ~ ^/(signalexchange\.SignalExchange|management\.(ManagementService|ProxyService))/ {
        set $upstream_netbird_grpc netbird-server:80;
        grpc_pass grpc://$upstream_netbird_grpc;
        grpc_set_header Host $host;
        grpc_set_header X-Real-IP $remote_addr;
        grpc_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        grpc_set_header X-Forwarded-Proto https;
        grpc_read_timeout 1d;
        grpc_send_timeout 1d;
        grpc_socket_keepalive on;
    }

    location ~ ^/(relay|ws-proxy/) {
        set $upstream_netbird netbird-server:80;
        proxy_pass http://$upstream_netbird;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 1d;
        proxy_send_timeout 1d;
    }

    location ~ ^/(api|oauth2)/ {
        set $upstream_netbird netbird-server:80;
        proxy_pass http://$upstream_netbird;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        set $upstream_netbird_dashboard netbird-dashboard:80;
        proxy_pass http://$upstream_netbird_dashboard;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

server {
    listen 443 ssl default_server;
    server_name __SUPPORT_HOST__;
    resolver 127.0.0.11 valid=30s;

    ssl_certificate __SSL_CERT_PATH__;
    ssl_certificate_key __SSL_KEY_PATH__;

    root /usr/share/nginx/html;
    index index.html;

    location /oauth2/ {
        set $upstream_oauth2_portal oauth2-proxy-portal:4180;
        proxy_pass http://$upstream_oauth2_portal;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /oauth2/auth {
        set $upstream_oauth2_portal oauth2-proxy-portal:4180;
        proxy_pass http://$upstream_oauth2_portal;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Content-Length "";
        proxy_pass_request_body off;
    }

    location ~ ^/automations(?:/|$) {
        auth_request /oauth2/auth;
        error_page 401 =302 /oauth2/start?rd=https://$host$request_uri;
        auth_request_set $auth_user $upstream_http_x_auth_request_user;
        auth_request_set $auth_email $upstream_http_x_auth_request_email;

        set $upstream_support_tools support-tools:8000;
        proxy_pass http://$upstream_support_tools;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Auth-Request-User $auth_user;
        proxy_set_header X-Auth-Request-Email $auth_email;
    }

    location / {
        auth_request /oauth2/auth;
        error_page 401 =302 /oauth2/start?rd=https://$host$request_uri;
        auth_request_set $auth_user $upstream_http_x_auth_request_user;
        auth_request_set $auth_email $upstream_http_x_auth_request_email;
        add_header X-Auth-Request-User $auth_user always;
        add_header X-Auth-Request-Email $auth_email always;
        try_files $uri $uri/ /index.html;
    }

    location /healthz {
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }
}
